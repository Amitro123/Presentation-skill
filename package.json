{
  "name": "presentation-skill",
  "private": true,
  "description": "HTML presentation template and AI skill",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate": "npx --yes html-validate@9 \"skills/html-presentation/assets/*.html\" \"examples/*.html\"",
    "audit": "node skills/html-presentation/scripts/audit-deck.js skills/html-presentation/assets/template.html examples/quarterly-review.html examples/hebrew-example.html",
    "build:examples": "node skills/html-presentation/scripts/build-deck.js examples/quarterly-review.json --out=examples/quarterly-review.html && node skills/html-presentation/scripts/build-deck.js examples/hebrew-example.json --out=examples/hebrew-example.html",
    "package": "python3 tools/package_skill.py"
  },
  "devDependencies": {
    "html-validate": "^9",
    "playwright": "^1"
  }
}
